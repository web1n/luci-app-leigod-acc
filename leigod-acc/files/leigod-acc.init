#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

STATE=/var/run/leigod-acc.owned
BINARY=/usr/sbin/leigod/acc-gw.router

firewall_rule() {
	json_add_object ""
	json_add_string type rule
	json_add_string src lan
	json_add_string family ipv4
	json_add_string proto "$1"
	[ -n "$2" ] && json_add_string dest_port "$2"
	[ -n "$3" ] && json_add_string mark "$3"
	json_add_string target ACCEPT
	json_close_object
}

clean_rules() {
	[ -f "$STATE" ] || return 0
	nft delete table inet tproxy_table 2>/dev/null
	ip -4 rule del fwmark 0x99 lookup 100 2>/dev/null
	ip -4 route del local default dev lo table 100 2>/dev/null
	rm -f "$STATE"
}

start_service() {
	local enabled
	config_load leigod-acc
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	[ -x /sbin/fw4 ] && [ -x "$BINARY" ] || return 1

	if [ -f "$STATE" ] && ! procd_running leigod-acc; then
		stop_service
		clean_rules
	fi
	if [ ! -f "$STATE" ]; then
		if nft list table inet tproxy_table >/dev/null 2>&1 ||
			[ -n "$(ip -4 route show table 100 2>/dev/null)" ] ||
			ip -4 rule show | grep -Eq 'fwmark 0x99(/0x[[:xdigit:]]+)?([[:space:]]|$)'; then
			logger -t leigod-acc 'TProxy table, routing table 100 or mark 0x99 is already in use.'
			return 1
		fi
		touch "$STATE" || return 1
	fi
	procd_open_instance
	procd_set_param command "$BINARY" -r daemon -m tproxy -p 5588 -l 0.0.0.0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_open_data
	json_add_array firewall
	firewall_rule tcp 5588 ''
	firewall_rule tcpudp '' '0x99/0xff'
	json_close_array
	procd_close_data
	procd_close_instance
}

stop_service() {
	local p exe
	[ -f "$STATE" ] || return 0
	nft delete table inet tproxy_table 2>/dev/null
	for p in /proc/[0-9]*; do
		exe="$(readlink "$p/exe" 2>/dev/null)"
		case "$exe" in /usr/sbin/leigod/acc-gw.router.*) kill -KILL "${p##*/}" 2>/dev/null ;; esac
	done
}

service_started() {
	[ ! -f "$STATE" ] || procd_set_config_changed firewall
}

service_stopped() {
	clean_rules
	procd_set_config_changed firewall
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger leigod-acc
}
